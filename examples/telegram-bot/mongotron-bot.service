[Unit]
Description=Mongotron Telegram Bot
After=network.target mongotron-api.service

[Service]
Type=simple
User=mongotron
WorkingDirectory=/path/to/mongotron/examples/telegram-bot
Environment="PATH=/path/to/mongotron/examples/telegram-bot/venv/bin"
ExecStart=/path/to/mongotron/examples/telegram-bot/venv/bin/python bot.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
